# Copie para .env (NUNCA versionado) e preencha com valores reais.
# Em producao use as config vars da plataforma (ex.: `heroku config:set`).

# Porta HTTP local
PORT=3000

# Segredo de assinatura dos JWT. Obrigatorio - a API nao sobe sem ele.
# Gere um novo com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=REPLACE_ME

# Credenciais AWS usadas para ler o secret `firebaseServiceAccountKey` no Secrets Manager
AWS_ACCESS_KEY_ID=REPLACE_ME
AWS_SECRET_ACCESS_KEY=REPLACE_ME

# Logtail / BetterStack (opcional - sem token o logger cai para console)
LOGTAIL_SOURCE_TOKEN=REPLACE_ME
LOGTAIL_ENDPOINT=https://REPLACE_ME.betterstackdata.com
